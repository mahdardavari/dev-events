{
    "name": "searchEvents",
    "description": "Search for events by title, tag, location or date",
    "inputs": {
        "query": {
            "type": "string",
            "required": true,
            "description": "Keyword to search for (title, tag, location)"
        },
        "mode": {
            "type": "string",
            "required": false,
            "enum": [
                "online",
                "offline",
                "hybrid"
            ],
            "description": "Filter by event type"
        },
        "date": {
            "type": "string",
            "required": false,
            "description": "Date in YYYY-MM-DD format"
        }
    },
    "output": {
        "type": "array",
        "items": {
            "type": "object",
            "properties": {
                "title": "string",
                "slug": "string",
                "date": "string",
                "location": "string",
                "mode": "string",
                "tags": "array"
            }
        }
    },
    "handler": "lib/actions/event.actions/searchEvents.ts"
}