{
    "name": "eventAnalytics",
    "description": "Get statistics and analytics from events and bookings",
    "inputs": {
        "eventSlug": {
            "type": "string",
            "required": false,
            "description": ""
        },
        "timeRange": {
            "type": "string",
            "required": false,
            "enum": [
                "week",
                "month",
                "year"
            ],
            "default": "month",
            "description": "Time range for statistic"
        }
    },
    "output": {
        "type": "object",
        "properties": {
            "totalEvents": "number",
            "totalBookings": "number",
            "popularTags": "array",
            "upcomingEvents": "array"
        }
    },
    "handler": "lib/actions/event.actions/eventAnalytics.ts"
}